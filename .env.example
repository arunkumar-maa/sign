# ── SignBridge AI environment configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Translation ───────────────────────────────────────────────────────────────
# Google Translate (free unofficial) or LibreTranslate
# Leave TRANSLATE_PROVIDER=libre for offline/free mode
TRANSLATE_PROVIDER=libre
# For LibreTranslate self-hosted or public instance:
LIBRE_TRANSLATE_URL=https://libretranslate.com
LIBRE_TRANSLATE_API_KEY=

# ── TTS ───────────────────────────────────────────────────────────────────────
# edge-tts (requires internet) or gtts
TTS_PROVIDER=edge-tts

# ── Speech-to-text ────────────────────────────────────────────────────────────
# Faster-Whisper model size: tiny, base, small, medium, large-v2
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Optional: TLive-Omni adapter ─────────────────────────────────────────────
# Only used if a separate TLive-Omni vLLM server is running.
TLIVE_ENABLED=false
TLIVE_BASE_URL=http://localhost:8001
TLIVE_MODEL=TaoLive-Omni-9B
TLIVE_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=data/signbridge.db

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Gradio ────────────────────────────────────────────────────────────────────
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
GRADIO_SHARE=false

# ── Recognition thresholds ───────────────────────────────────────────────────
STATIC_CONFIDENCE_THRESHOLD=0.75
DYNAMIC_CONFIDENCE_THRESHOLD=0.70

# ── Model paths ───────────────────────────────────────────────────────────────
STATIC_MODEL_PATH=models/static/isl_static_v1.keras
DYNAMIC_MODEL_PATH=models/dynamic/isl_dynamic_v1.keras
STATIC_LABELS_PATH=models/labels/static_labels.json
DYNAMIC_LABELS_PATH=models/labels/dynamic_labels.json
